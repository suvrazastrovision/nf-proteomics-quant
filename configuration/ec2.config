// Run via scripts/ec2-run.sh to size these values for the EC2 host.
// Direct invocation can override --ec2_cpus and --ec2_memory.
params {
  ec2_cpus = 2
  ec2_memory = '8 GB'
}

docker {
  enabled = true
  fixOwnership = true
}

executor {
  cpus = params.ec2_cpus
  memory = params.ec2_memory
  queueSize = 1
}

process {
  executor = 'local'
  cpus = params.ec2_cpus
  memory = params.ec2_memory
  time = 48.h
  resourceLimits = [cpus: params.ec2_cpus, memory: params.ec2_memory, time: 7.d]
  // Retrying with the same memory budget will not fix an out-of-memory error.
  errorStrategy = 'terminate'

  // Override the input-size estimate inherited from base.config.
  withName: combineEmpiricalLibraryRuns {
    memory = params.ec2_memory
  }
}

// Keep downloaded results usable independently of the work directory.
workflow.output.mode = 'copy'
report.overwrite = true
timeline.overwrite = true
